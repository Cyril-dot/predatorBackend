# Copy this file to .env (or export these as real environment variables)
# and fill in your actual Neon connection details.
# Get them from: Neon Console -> your project -> Connection Details.

# Use the pooled connection string Neon gives you, e.g.:
# DATABASE_URL=jdbc:postgresql://ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=jdbc:postgresql://<your-neon-host>/<your-db-name>?sslmode=require
DATABASE_USERNAME=<your-neon-username>
DATABASE_PASSWORD=<your-neon-password>

# Optional tuning
DB_POOL_SIZE=5
DB_POOL_MIN_IDLE=1
# Use "validate" instead of "update" once your schema is stable / in production
DB_DDL_AUTO=update

# Other existing secrets (unchanged) - fill these in too
NVIDIA_API_KEY=
OPENROUTER_API_KEYS=
CLOUDFARE_KEYS=
